{
  "db_name": "PostgreSQL",
  "query": "SELECT o.id, o.listing_id, o.price, o.status, o.updated_at, l.person_id, l.variant, l.price AS list_price, l.seller_id\n         FROM market_offers o JOIN market_listings l ON l.id = o.listing_id WHERE o.buyer_id = $1\n         AND (o.status = 'pending' OR o.updated_at > $2) ORDER BY o.id DESC LIMIT 40",
