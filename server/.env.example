DATABASE_URL=postgres://postgres:postgres@localhost:5432/scambox
# TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/scambox_test
# SECRET_KEY=...            (bez tego: DATA_DIR/secret_key.txt)
# DATA_DIR=..               (zdjęcia i klucz; domyślnie folder gry)
# METRICS_ADDR=127.0.0.1:9100
RUST_LOG=scambox=info
# zapytania sqlx::query! sprawdzane z .sqlx/ (bez bazy przy budowaniu); po zmianie zapytań: false + cargo sqlx prepare
SQLX_OFFLINE=true
